+void libvisio::VSDPages::_insertConnectionPoints(librevenge::RVNGPropertyList &pageProps, const libvisio::VSDPage &page)
+{
+  if (page.m_connectionPoints.empty())
+    return;
+  librevenge::RVNGPropertyListVector points;
+  for (const auto &point : page.m_connectionPoints)
+  {
+    librevenge::RVNGPropertyList p;
+    p.insert("svg:x", point.first);
+    p.insert("svg:y", point.second);
+    points.append(p);
+  }
+  pageProps.insert("libvisio:connection-points", points);
+}
