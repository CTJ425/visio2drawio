{
  "name": "visio2drawio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "preview": "serve out -l 3000",
    "lint": "oxlint",
    "build:native": "mkdir -p bin && g++ -O3 src-native/vss2drawio.cpp -o bin/vss2drawio $(pkg-config --cflags --libs libvisio-0.1 librevenge-0.0 librevenge-stream-0.0)",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.32.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
