+void libvisio::VSDParser::readConnectionPoint(librevenge::RVNGInputStream *input)
+{
+  input->seek(1, librevenge::RVNG_SEEK_CUR);
+  double x = readDouble(input);
+  input->seek(1, librevenge::RVNG_SEEK_CUR);
+  double y = readDouble(input);
+
+  if (m_isShapeStarted)
+    m_shape.m_connectionPoints[m_header.id] = std::make_pair(x, y);
+}
